# Local Development Server Port
PORT=3000

# Supabase Cloud Database & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PROJECT_REF=your-project-ref-here
